+                case USILInstructionType.DerivativeRenderTargetY: F1(inst, "ddy"); return true;
+                case USILInstructionType.DerivativeRenderTargetXCoarse: F1(inst, "ddx_coarse"); return true;
+                case USILInstructionType.DerivativeRenderTargetYCoarse: F1(inst, "ddy_coarse"); return true;
+                case USILInstructionType.DerivativeRenderTargetXFine: F1(inst, "ddx_fine"); return true;
+                case USILInstructionType.DerivativeRenderTargetYFine: F1(inst, "ddy_fine"); return true;
