+using D = AssetRipper.Export.Modules.Shaders.UltraShaderConverter.USIL.USILOperand.Domain;
+
+namespace AssetRipper.Export.Modules.Shaders.UltraShaderConverter.UShader.Function
+{
+    // Bit-exact emission (USILOperand.BitExact, AG_BITEXACT env, default on).
+    //
+    // DXBC temps are typeless 32-bit registers; each instruction interprets them as float,
+    // int or uint. Temps are declared uint4 and hold raw bits; every instruction reads its
+    // operands in its own domain (asfloat / asint / raw) and writes raw bits back
+    // (asuint(float) / asuint(int) / uint). Comparisons produce 0xFFFFFFFF / 0 like DXBC.
+    // Also fixes: DXBC log is log2 (upstream printed the natural log), ineg is an integer
+    // negate, ushr is a logical shift, and shift counts use the low 5 bits.
+    public partial class UShaderFunctionToHLSL
+    {
+        static bool FloatMods(USILOperand op) => op.negative || op.absoluteValue;
+
+        string Sat(USILInstruction inst, string e) => inst.saturate ? $"saturate({e})" : e;
+
+        void Assign(USILInstruction inst, string expr, D domain)
+        {
+            USILOperand dst = inst.destOperand;
+            string rhs = dst.IsBitStorage
+                ? (domain == D.U ? expr : $"asuint({expr})")
+                : (domain == D.F ? expr : $"asfloat({expr})");
+            AppendLine($"{CommentString(inst)}{dst} = {rhs};");
+        }
+
+        static int Width(USILInstruction inst) => Math.Max(1, inst.destOperand.mask.Length);
+
+        static string CastN(string t, int n) => n == 1 ? t : $"{t}{n}";
+
+        bool EmitBitExact(USILInstruction inst)
+        {
+            List<USILOperand> s = inst.srcOperands;
+            int n = inst.destOperand != null ? Width(inst) : 1;
+            D intDom = inst.isIntUnsigned ? D.U : D.I;
+            switch (inst.instructionType)
+            {
+                case USILInstructionType.Move:
+                {
+                    if (inst.saturate || FloatMods(s[0]) || !inst.destOperand.IsBitStorage)
+                        Assign(inst, Sat(inst, s[0].Read(D.F)), D.F);
+                    else
+                        Assign(inst, s[0].Read(D.U), D.U);   // mov is a bit copy
+                    return true;
+                }
+                case USILInstructionType.MoveConditional:
+                {
+                    bool asFloat = inst.saturate || FloatMods(s[1]) || FloatMods(s[2]) || !inst.destOperand.IsBitStorage;
+                    D d = asFloat ? D.F : D.U;
+                    string cond = $"({s[0].Read(D.U)} != 0u)";
+                    Assign(inst, Sat(inst, $"({cond} ? {s[1].Read(d)} : {s[2].Read(d)})"), d);
+                    return true;
+                }
+                case USILInstructionType.Add:
+                case USILInstructionType.Subtract:
+                case USILInstructionType.Multiply:
+                case USILInstructionType.Divide:
+                case USILInstructionType.MultiplyAdd:
+                case USILInstructionType.Minimum:
+                case USILInstructionType.Maximum:
+                {
+                    D d = inst.isIntVariant ? intDom : D.F;
+                    string a = s[0].Read(d), b = s.Count > 1 ? s[1].Read(d) : "";
+                    string e = inst.instructionType switch
+                    {
+                        USILInstructionType.Add => $"{a} + {b}",
+                        USILInstructionType.Subtract => $"{a} - {b}",
+                        USILInstructionType.Multiply => $"{a} * {b}",
+                        USILInstructionType.Divide => $"{a} / {b}",
+                        USILInstructionType.MultiplyAdd => $"{a} * {b} + {s[2].Read(d)}",
+                        USILInstructionType.Minimum => $"min({a}, {b})",
+                        _ => $"max({a}, {b})",
+                    };
+                    Assign(inst, d == D.F ? Sat(inst, e) : e, d);
+                    return true;
+                }
+                case USILInstructionType.And:
+                    Assign(inst, $"{s[0].Read(D.U)} & {s[1].Read(D.U)}", D.U); return true;
+                case USILInstructionType.Or:
+                    Assign(inst, $"{s[0].Read(D.U)} | {s[1].Read(D.U)}", D.U); return true;
+                case USILInstructionType.Xor:
+                    Assign(inst, $"{s[0].Read(D.U)} ^ {s[1].Read(D.U)}", D.U); return true;
+                case USILInstructionType.Not:
+                    Assign(inst, $"~{s[0].Read(D.U)}", D.U); return true;
+                case USILInstructionType.ShiftLeft:
+                    Assign(inst, $"{s[0].Read(D.U)} << ({s[1].Read(D.U)} & 31u)", D.U); return true;
