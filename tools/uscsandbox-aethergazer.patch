+                case USILInstructionType.Fractional: F1(inst, "frac"); return true;
+                case USILInstructionType.Floor: F1(inst, "floor"); return true;
+                case USILInstructionType.Ceiling: F1(inst, "ceil"); return true;
+                case USILInstructionType.Round: F1(inst, "round"); return true;
+                case USILInstructionType.Truncate: F1(inst, "trunc"); return true;
+                case USILInstructionType.Sine: F1(inst, "sin"); return true;
+                case USILInstructionType.Cosine: F1(inst, "cos"); return true;
+                case USILInstructionType.ToThePower:
