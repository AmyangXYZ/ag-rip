+
+        void F1(USILInstruction inst, string fn) =>
+            Assign(inst, Sat(inst, $"{fn}({inst.srcOperands[0].Read(D.F)})"), D.F);
+
+        // same texture calls as the upstream handlers, coordinates read as float (int for ld)
+        void EmitSample(USILInstruction inst)
+        {
+            List<USILOperand> s = inst.srcOperands;
+            USILOperand tex = inst.instructionType is USILInstructionType.LoadResource or USILInstructionType.LoadResourceMultisampled
+                ? s[1] : s[2];
+            string value;
+            switch (inst.instructionType)
+            {
+                case USILInstructionType.SampleComparison:
+                case USILInstructionType.SampleComparisonLODZero:
+                    value = $"UNITY_SAMPLE_SHADOW({s[2].metadataName ?? s[2].ToString()}, float3({s[0].Read(D.F)}, {s[3].Read(D.F)}))";
+                    break;
+                case USILInstructionType.LoadResource:
+                case USILInstructionType.LoadResourceMultisampled:
+                    value = $"{s[1]}.Load({s[0].Read(D.I)})";
+                    break;
+                case USILInstructionType.SampleDerivative:
+                {
+                    string args = $"{s[2]}, {s[0].Read(D.F)}, {s[3].Read(D.F)}, {s[4].Read(D.F)}";
+                    value = tex.operandType switch
+                    {
+                        USILOperandType.Sampler3D => $"tex3Dgrad({args})",
+                        USILOperandType.SamplerCube => $"texCUBEgrad({args})",
+                        _ => $"tex2Dgrad({args})",
+                    };
+                    break;
+                }
+                case USILInstructionType.SampleLOD:
+                case USILInstructionType.SampleLODBias:
+                {
+                    bool bias = inst.instructionType == USILInstructionType.SampleLODBias;
+                    string uv = s[0].mask.Length == 2 ? $"float4({s[0].Read(D.F)}, 0, {s[3].Read(D.F)})"
+                                                     : $"float4({s[0].Read(D.F)}, {s[3].Read(D.F)})";
+                    string args = $"{s[2]}, {uv}";
+                    value = tex.operandType switch
+                    {
+                        USILOperandType.Sampler3D => bias ? $"tex3Dbias({args})" : $"tex3Dlod({args})",
+                        USILOperandType.SamplerCube => bias ? $"texCUBEbias({args})" : $"texCUBElod({args})",
+                        USILOperandType.Sampler2DArray => $"UNITY_SAMPLE_TEX2DARRAY_LOD({args})",
+                        USILOperandType.SamplerCubeArray => $"UNITY_SAMPLE_TEXCUBEARRAY_LOD({args})",
+                        _ => bias ? $"tex2Dbias({args})" : $"tex2Dlod({args})",
+                    };
+                    break;
+                }
+                default:
+                {
+                    string args = $"{s[2]}, {s[0].Read(D.F)}";
+                    value = tex.operandType switch
+                    {
+                        USILOperandType.Sampler3D => $"tex3D({args})",
+                        USILOperandType.SamplerCube => $"texCUBE({args})",
+                        USILOperandType.Sampler2DArray => $"UNITY_SAMPLE_TEX2DARRAY({args})",
+                        USILOperandType.SamplerCubeArray => $"UNITY_SAMPLE_TEXCUBEARRAY({args})",
+                        _ => $"tex2D({args})",
+                    };
+                    break;
+                }
+            }
+            // each destination component takes the resource swizzle's component (already
+            // mapped onto the texture operand's mask); upstream relied on implicit truncation
+            // shadow compares return a scalar
+            bool scalar = inst.instructionType is USILInstructionType.SampleComparison or USILInstructionType.SampleComparisonLODZero;
+            string sw = scalar ? "" : SwizzleOf(inst, tex);
+            string e = sw.Length > 0 ? $"({value}){sw}" : value;
+            Assign(inst, e, D.F);
+        }
+
+        static string SwizzleOf(USILInstruction inst, USILOperand tex)
+        {
+            int[] dm = inst.destOperand.mask;
+            int[] m = tex.mask.Length == dm.Length && dm.Length > 0 ? tex.mask : dm;
+            if (m.Length == 0 || (m.Length == 4 && m[0] == 0 && m[1] == 1 && m[2] == 2 && m[3] == 3)) return "";
+            return "." + string.Concat(m.Select(i => "xyzw"[i]));
+        }
+    }
+}
